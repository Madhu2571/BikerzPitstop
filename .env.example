# ========================================================
# BIKERZ PITSTOP COIMBATORE - ENVIRONMENT CONFIGURATION
# ========================================================

# ADMIN SECURITY & AUTHENTICATION (Server-side ONLY)
# Replace with your approved administrator email address:
ADMIN_EMAIL="admin@yourdomain.com"

# Set a strong password for your admin account:
ADMIN_PASSWORD="your-secure-admin-password"

# A secure random secret key for signing admin session tokens:
ADMIN_JWT_SECRET="your-secure-jwt-signing-secret"
ADMIN_SESSION_SECRET="your-secure-jwt-signing-secret"

# PUBLIC STORE CONFIGURATION (Optional overrides)
NEXT_PUBLIC_STORE_PHONE="93442 30478"
NEXT_PUBLIC_STORE_WHATSAPP="919344230478"
NEXT_PUBLIC_STORE_INSTAGRAM="bikerz_pitstop_coimbatore"

# ========================================================
# SUPABASE CLOUD PERSISTENT DATABASE & STORAGE (Production)
# ========================================================
# 1. Project URL from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Service Role Secret Key (Server-side ONLY - used by Admin APIs & migrations)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-from-supabase"

# 3. Anon Public Key (Used for public read access / storage)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-from-supabase"
